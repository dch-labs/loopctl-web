---
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource-variable/fraunces/opsz-italic.css';
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/newsreader/opsz-italic.css';
import '@fontsource-variable/jetbrains-mono';

const { head } = Astro.locals.starlightRoute;
---

{head.map(({ tag: Tag, attrs, content }) => <Tag {...attrs} set:html={content} />)}
<script is:inline>
  (() => {
    try {
      const s = JSON.parse(localStorage.getItem('loopctl-reading') || '{}');
      const r = document.documentElement;
      if (s.body) r.dataset.readBody = s.body;
      if (s.code) r.dataset.readCode = s.code;
      if (s.scale) r.style.setProperty('--read-scale', s.scale);
      if (s.leading) r.style.setProperty('--read-leading', s.leading);
      if (s.measure) r.style.setProperty('--read-measure', s.measure);
    } catch {}
    try {
      localStorage.removeItem('loopctl-sidebars');
      const sb = JSON.parse(sessionStorage.getItem('loopctl-sidebars') || '{}');
      const r = document.documentElement;
      if (sb.left) r.dataset.hideLeft = '1';
      if (sb.right) r.dataset.hideRight = '1';
    } catch {}
  })();
</script>
<script>
  import { initMermaid } from '../scripts/mermaid';
  import { initReadingPanel } from '../scripts/reading';
  import { initSidebarToggle } from '../scripts/sidebar-toggle';
  import { initThemeToggle } from '../scripts/theme-toggle';

  function boot() {
    initMermaid();
    initReadingPanel();
    initSidebarToggle();
    initThemeToggle();
  }
  boot();
  document.addEventListener('astro:after-swap', boot);
</script>
