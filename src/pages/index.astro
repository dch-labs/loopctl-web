---
import '../styles/custom.css';

const sections = [
  { num: 'i.', name: 'Start here', count: 4, href: '/start-here/what-is-loopctl/', note: 'the twenty-line agent' },
  { num: 'ii.', name: 'Core data', count: 6, href: '/core-data/messages/', note: 'messages, tools, streams' },
  { num: 'iii.', name: 'The engine', count: 8, href: '/engine/state-machine/', note: 'every step of a run' },
  { num: 'iv.', name: 'Safety systems', count: 8, href: '/safety/loop-detection/', note: 'staying alive & harmless' },
  { num: 'v.', name: 'Extensions', count: 5, href: '/extensions/observers/', note: 'observers, hooks, memory' },
  { num: 'vi.', name: 'Providers', count: 7, href: '/providers/overview/', note: 'five families, one trait' },
  { num: 'vii.', name: 'Integration', count: 5, href: '/integration/structured-output/', note: 'MCP, derive, presets' },
  { num: 'viii.', name: 'File reference', count: 78, href: '/file-reference/', note: 'one page per source file' },
  { num: 'ix.', name: 'Cookbook', count: 2, href: '/cookbook/recipes/', note: '14 recipes, every gotcha' },
  { num: 'x.', name: 'Principles', count: 12, href: '/principles/sans-io/', note: 'the ideas underneath' },
];

const safety = [
  { name: 'Middleware', href: '/safety/middleware/', desc: 'The dispatch pipeline: timeouts, permission gates, output limits, redaction — compose your own.' },
  { name: 'Loop detection', href: '/safety/loop-detection/', desc: 'Catches the model asking for the same thing forever, and stops the bleed.' },
  { name: 'Convergence detection', href: '/safety/convergence/', desc: 'Knows when repetition is progress, not a rut, so legitimate work survives.' },
  { name: 'Model fallback', href: '/safety/fallback/', desc: 'Circuit-breaker chains that hand a dying run to a backup model mid-flight.' },
  { name: 'Reflection & recovery', href: '/safety/reflection/', desc: 'Turns failures into retries with a plan instead of dying on the first 500.' },
  { name: 'Tool health', href: '/safety/tool-health/', desc: 'Scores your tools from their results and stops calling the flaky ones.' },
  { name: 'The shield', href: '/safety/tool-shield/', desc: 'A final safety check on tool arguments before anything executes.' },
  { name: 'Permissions', href: '/safety/permission/', desc: 'Let the model read freely; make it ask before it writes.' },
];

const ideas = [
  { name: 'You own the decisions', desc: 'the framework owns the mechanics. Nothing is on that you did not turn on; no model is picked for you.' },
  { name: 'Bring your own model', desc: 'five provider families out of the box, OpenAI-compatible profiles for the rest, or one trait — ApiClient — for your own.' },
  { name: 'Tools are plain Rust', desc: 'a name, a description, a schema, an async function — or let #[derive(Tool)] write the scaffolding.' },
  { name: 'No panics. Ever.', desc: 'the crate builds with panic = "deny"; a crashing tool becomes an error message the model can read and react to.' },
  { name: 'Pay only for what you use', desc: 'zero default features. Streaming, hooks, MCP, each provider — every one is an opt-in flag.' },
];
---

