    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('starlight-theme');
          const dark =
            stored === 'dark' ||
            (!stored && window.matchMedia('(prefers-color-scheme: dark)').matches);
          document.documentElement.dataset.theme = dark ? 'dark' : 'light';
        } catch {
          document.documentElement.dataset.theme = 'light';
        }
        try {
          const s = JSON.parse(localStorage.getItem('loopctl-reading') || '{}');
          const r = document.documentElement;
          if (s.body) r.dataset.readBody = s.body;
          if (s.code) r.dataset.readCode = s.code;
          if (s.scale) r.style.setProperty('--read-scale', s.scale);
          if (s.leading) r.style.setProperty('--read-leading', s.leading);
          if (s.measure) r.style.setProperty('--read-measure', s.measure);
        } catch {}
      })();
    </script>
